# AI that reads the sheet photos. Set up ONE of these.
# 1) Free and private: a vision model on another computer running Ollama (see README "Run the AI on your laptop").
OLLAMA_URL=
OLLAMA_MODEL=qwen3-vl:8b
# 2) Free: Google Gemini key from https://aistudio.google.com/apikey (free tier, Flash models).
GEMINI_API_KEY=
# 3) Paid: Anthropic key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# auto = first one set above, in that order. Or force: ollama | gemini | claude
AI_PROVIDER=auto

# Optional: protect the web UI with HTTP basic auth (recommended if reachable beyond your LAN).
APP_USERNAME=hisab
APP_PASSWORD=

# Address you open Hisab at; used for links in WhatsApp replies.
PUBLIC_URL=http://raspberrypi.local:8000

# --- WhatsApp (see README "Connect WhatsApp") ---
# Two random secrets shared by the hisab and waha containers. Generate each with:  openssl rand -hex 24
WAHA_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
# Reply in the chat with what was read.
WHATSAPP_REPLY=true
# Save WhatsApp sheets straight to the ledger when totals match and every line was clear.
WHATSAPP_AUTO_SAVE=false
# WAHA_IMAGE_TAG=gows        # use on x86_64; the default gows-arm is for Raspberry Pi

# Optional tuning
# OLLAMA_TIMEOUT=900         # seconds to wait for the local model per sheet
# OLLAMA_NUM_CTX=16384       # context size; raise if long sheets get cut off
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-opus-5-5
# PARSE_EFFORT=high          # Claude only: low | medium | high | xhigh | max
# PARSE_MAX_EDGE_PX=2000     # photos are shrunk to this long edge before sending
# CURRENCY=₹
# MAX_UPLOAD_MB=25
