# Required: key from https://console.anthropic.com — used to read the sheet photos.
ANTHROPIC_API_KEY=

# Optional: protect the web UI with HTTP basic auth (recommended if reachable beyond your LAN).
APP_USERNAME=hisab
APP_PASSWORD=

# Optional tuning
# ANTHROPIC_MODEL=claude-opus-5-5
# PARSE_EFFORT=high          # low | medium | high | xhigh | max
# PARSE_MAX_EDGE_PX=2000     # photos are shrunk to this long edge before sending
# CURRENCY=₹
# MAX_UPLOAD_MB=25
