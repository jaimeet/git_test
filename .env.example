# AI that reads the sheet photos. Set ONE of these keys.
# Free: Google Gemini key from https://aistudio.google.com/apikey (free tier, Flash models).
GEMINI_API_KEY=
# Paid alternative: Anthropic key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# auto = Gemini if GEMINI_API_KEY is set, otherwise Claude. Or force: gemini | claude
AI_PROVIDER=auto

# Optional: protect the web UI with HTTP basic auth (recommended if reachable beyond your LAN).
APP_USERNAME=hisab
APP_PASSWORD=

# Address you open Hisab at; used for links in WhatsApp replies.
PUBLIC_URL=http://raspberrypi.local:8000

# --- WhatsApp (see README "Connect WhatsApp") ---
# Two random secrets shared by the hisab and waha containers. Generate each with:  openssl rand -hex 24
WAHA_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
# Reply in the chat with what was read.
WHATSAPP_REPLY=true
# Save WhatsApp sheets straight to the ledger when totals match and every line was clear.
WHATSAPP_AUTO_SAVE=false
# WAHA_IMAGE_TAG=gows        # use on x86_64; the default gows-arm is for Raspberry Pi

# Optional tuning
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-opus-5-5
# PARSE_EFFORT=high          # Claude only: low | medium | high | xhigh | max
# PARSE_MAX_EDGE_PX=2000     # photos are shrunk to this long edge before sending
# CURRENCY=₹
# MAX_UPLOAD_MB=25
